{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trainer — program specification",
  "description": "Single source of truth. The PDF plan, mobile view and Excel tracker all render from this file, so they cannot disagree.",
  "type": "object",
  "required": ["client", "strategy", "block", "sessions"],
  "additionalProperties": false,
  "properties": {
    "client": {
      "type": "object",
      "required": ["training_age", "goal_primary", "days_per_week", "session_minutes", "equipment"],
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "integer", "minimum": 10, "maximum": 100 },
        "sex": { "type": "string" },
        "height_cm": { "type": "number" },
        "weight_kg": { "type": "number" },
        "training_age": { "enum": ["beginner", "intermediate", "advanced"] },
        "goal_primary": { "type": "string" },
        "goal_secondary": { "type": "string" },
        "days_per_week": { "type": "integer", "minimum": 1, "maximum": 7 },
        "session_minutes": { "type": "integer", "minimum": 10, "maximum": 240 },
        "environment": { "type": "string", "description": "commercial gym | home gym | limited equipment | bodyweight only" },
        "equipment": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" }, "description": "injuries, pain, medical restrictions — each must be addressed in strategy.assumptions or an exercise note" },
        "sleep_hours": { "type": "number" },
        "activity_level": { "type": "string" },
        "dislikes": { "type": "array", "items": { "type": "string" } },
        "units": { "enum": ["kg", "lb"], "default": "kg" }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["split", "rationale", "progression_model", "assumptions"],
      "properties": {
        "split": { "type": "string" },
        "rationale": { "type": "string", "description": "why THIS split for THIS person — days, recovery, goal" },
        "weekly_volume_notes": { "type": "string" },
        "progression_model": { "type": "string", "description": "e.g. double progression: add reps to top of range, then add load" },
        "deload_policy": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" }, "description": "everything you programmed on but did not confirm" }
      }
    },
    "block": {
      "type": "object",
      "required": ["name", "weeks"],
      "properties": {
        "name": { "type": "string" },
        "weeks": { "type": "integer", "minimum": 1, "maximum": 16 },
        "start_date": { "type": "string", "description": "YYYY-MM-DD" },
        "review_after_weeks": { "type": "integer", "default": 4 }
      }
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "name", "exercises"],
        "properties": {
          "day": { "type": "string", "description": "Mon..Sun or 'Day 1'" },
          "name": { "type": "string" },
          "focus": { "type": "string" },
          "warmup": { "type": "array", "items": { "type": "string" } },
          "cooldown": { "type": "array", "items": { "type": "string" } },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "sets", "reps", "rest_sec", "rir"],
              "properties": {
                "name": { "type": "string" },
                "pattern": { "type": "string" },
                "muscles": { "type": "array", "items": { "type": "string" } },
                "sets": { "type": "integer", "minimum": 1, "maximum": 10 },
                "reps": { "type": "string", "description": "range like '8-12', or '5', or 'AMRAP'" },
                "rest_sec": { "type": "integer", "minimum": 15, "maximum": 600 },
                "rir": { "type": "string", "description": "'2' or '1-3'" },
                "load_guidance": { "type": "string" },
                "cues": { "type": "string", "description": "one or two, not a paragraph" },
                "alternative": { "type": "string", "description": "swap for busy gym / missing kit / bad joint day" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "how"],
        "properties": {
          "metric": { "type": "string" },
          "how": { "type": "string" },
          "every_weeks": { "type": "integer" },
          "baseline": { "type": "string" }
        }
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "sleep": { "type": "string" },
        "nutrition_note": { "type": "string", "description": "brief and non-prescriptive unless asked" },
        "deload_trigger": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
